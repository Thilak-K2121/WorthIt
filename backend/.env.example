# Database Configuration (Supabase / PostgreSQL or local SQLite)
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# External AI & Search APIs
TAVILY_API_KEY=your_tavily_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Response cache: auto (Redis if REDIS_URL is set, else server RAM) | memory | redis | off
CACHE_BACKEND=auto
CACHE_TTL_SECONDS=600
CACHE_MAX_MB=64
# Optional. Leave empty to cache in server RAM.
REDIS_URL=

# Admin console key for adding/deleting catalog entries (sent as X-Admin-Key). Required in production.
ADMIN_API_KEY=generate_a_long_random_string

# App Environment
ENVIRONMENT=production
DEBUG=false
CORS_ORIGINS=*
